<?xml version="1.0" encoding="utf-8"?><Project Sdk="Microsoft.NET.Sdk.Web"><PropertyGroup><TargetFramework Condition="$([MSBuild]::IsOsPlatform('OSX'))">net10.0-macos</TargetFramework><ServerGarbageCollection Condition="$([MSBuild]::IsOsPlatform('OSX'))">false</ServerGarbageCollection><ApplicationId Condition="$([MSBuild]::IsOsPlatform('OSX'))">com.visioforge.rtspwebcamblazorserver</ApplicationId><RunWithOpen Condition="$([MSBuild]::IsOsPlatform('OSX'))">false</RunWithOpen><RuntimeIdentifier Condition="$([MSBuild]::IsOsPlatform('OSX')) and '$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier><TargetFramework Condition="$([MSBuild]::IsOsPlatform('Windows'))">net10.0-windows</TargetFramework><TargetFramework Condition="$([MSBuild]::IsOsPlatform('Linux'))">net10.0</TargetFramework><RootNamespace>RTSP_Webcam_Server</RootNamespace><PlatformTarget Condition="!$([MSBuild]::IsOsPlatform('OSX'))">x64</PlatformTarget><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup><ItemGroup><PackageReference Include="VisioForge.DotNet.MediaBlocks" Version="[2026.11.6]"/></ItemGroup><ItemGroup Condition="$([MSBuild]::IsOsPlatform('Windows'))"><PackageReference Include="VisioForge.CrossPlatform.Core.Windows.x64" Version="[2026.11.3]"/><PackageReference Include="VisioForge.CrossPlatform.Libav.Windows.x64.UPX" Version="[2026.11.3]"/></ItemGroup><ItemGroup Condition="$(TargetFramework.Contains('-macos'))"><PackageReference Include="VisioForge.CrossPlatform.Core.macOS" Version="[2026.11.5]"/></ItemGroup><ItemGroup Condition="$([MSBuild]::IsOsPlatform('Linux'))"><PackageReference Include="VisioForge.CrossPlatform.Core.Linux.x64" Version="[2026.10.26]"/><PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" /></ItemGroup><Target Name="CopyWebAssetsToBundle" AfterTargets="_CreateAppBundle" BeforeTargets="_CodesignAppBundle" Condition="$([MSBuild]::IsOsPlatform('MacOS'))"><ItemGroup><_BundledWebAsset Include="@(StaticWebA